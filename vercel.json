{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path(.*)",
      "destination": "/api"
    },
    {
      "source": "/:path((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
