# npm workspace install settings shared by local development, Render and Vercel.

# Always install devDependencies, even when NODE_ENV=production.
#
# This repository builds TypeScript. `typescript`, `tsx`, `@types/node`,
# `@types/express`, `@types/pg` and `@types/multer` are all devDependencies,
# and npm omits devDependencies whenever NODE_ENV=production — which is exactly
# how the production backend is meant to run, and what the Render service has
# NODE_ENV set to.
#
# The consequence is that `npm ci` would install runtime packages only. The
# backend build then has no `tsc` and no type declarations at all, and the
# compiler fails with a wall of errors that name runtime packages rather than
# the real cause, for example:
#
#   TS7016: Could not find a declaration file for module 'express'
#   TS7016: Could not find a declaration file for module 'pg'
#   TS2591: Cannot find name 'process'
#   TS2503: Cannot find namespace 'NodeJS'
#   TS2584: Cannot find name 'console'
#   TS2304: Cannot find name 'URL'
#
# Those errors mean "the type packages are not installed", not "the code is
# wrong". Nothing in the source needs to change to fix them.
#
# `include=dev` makes devDependencies install unconditionally. This is the
# behaviour npm already uses by default when NODE_ENV is not "production", so
# it changes nothing locally — it only stops the production environment from
# silently removing the toolchain the build needs.
#
# It is not a security or size regression: these packages are build-time only,
# are never imported by the running server, and are not reachable from any
# request. The alternative, adding --include=dev to every build command, is
# easy to forget and is exactly the kind of knowledge that should live with the
# repository rather than in a dashboard.
include=dev
