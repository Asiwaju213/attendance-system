# Copy this file to .env and replace the placeholder values with your own.

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=oou_attendance
DATABASE_USER=your_database_user
DATABASE_PASSWORD=your_database_password

# WebAuthn / Passkeys (Relying Party configuration).
# Only WEBAUTHN_RP_ID and WEBAUTHN_ORIGIN are required in production.
# WEBAUTHN_RP_NAME defaults to "OOU Attendance System" if not set.
#
# WEBAUTHN_RP_ID=attendance.oou.edu.ng
# WEBAUTHN_ORIGIN=https://attendance.oou.edu.ng
# WEBAUTHN_RP_NAME=OOU Attendance System